<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_amber">#F59E0B</color>
    <color name="accent_amber_light">#78350F</color>
    <color name="accent_coral">#F43F5E</color>
    <color name="accent_coral_light">#881337</color>
    <color name="accent_purple">#A855F7</color>
    <color name="accent_purple_light">#581C87</color>
    <color name="background">#0F172A</color>
    <color name="bronze">#CD7F32</color>
    <color name="card_background">#1E293B</color>
    <color name="divider">#334155</color>
    <color name="gold">#FFD700</color>
    <color name="highlight_user_bg">#1E293B</color>
    <color name="highlight_user_border">#3B82F6</color>
    <color name="primary">#3B82F6</color>
    <color name="primary_container">#1E293B</color>
    <color name="primary_dark">#2563EB</color>
    <color name="primary_light">#1E3A8A</color>
    <color name="secondary">#10B981</color>
    <color name="secondary_dark">#059669</color>
    <color name="secondary_light">#064E3B</color>
    <color name="silver">#C0C0C0</color>
    <color name="status_active">#10B981</color>
    <color name="status_completed">#3B82F6</color>
    <color name="status_error">#F87171</color>
    <color name="status_warning">#FBBF24</color>
    <color name="surface">#1E293B</color>
    <color name="surface_variant">#334155</color>
    <color name="text_on_primary">#FFFFFF</color>
    <color name="text_on_secondary">#FFFFFF</color>
    <color name="text_primary">#F8FAFC</color>
    <color name="text_secondary">#94A3B8</color>
    <color name="text_tertiary">#64748B</color>
    <style name="Theme.FitnessChallenge" parent="Theme.Material3.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>

        
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/text_on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_light</item>

        
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>

        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        
        <item name="materialCardViewStyle">@style/Widget.FitnessChallenge.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.FitnessChallenge.BottomNavigationView</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>
    <style name="Widget.FitnessChallenge.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="elevation">8dp</item>
        <item name="itemIconTint">@color/primary</item>
        <item name="itemTextColor">@color/primary</item>
        <item name="android:background">@color/surface</item>
    </style>
    <style name="Widget.FitnessChallenge.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider</item>
    </style>
</resources>