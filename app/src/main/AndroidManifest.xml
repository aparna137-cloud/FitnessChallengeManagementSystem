<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for Firebase Authentication & Cloud Firestore -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_fitness_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_fitness_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitnessChallenge">

        <!-- Launcher / Splash Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.FitnessChallenge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- User Core -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ChallengeDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AddActivityActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin Core -->
        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ManageChallengesActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AddEditChallengeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ManageUsersActivity"
            android:exported="false" />

        <activity
            android:name=".activities.UserDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AdminUserProgressActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ParticipantsActivity"
            android:exported="false" />

    </application>

</manifest>